# Copy this file to .env and fill in what you need. Everything is optional except the key
# (and without the key the app still runs; only the AI features are off).

# Claude writes the checks, translations and sentence explanations.
# Create a key at https://platform.claude.com/ and paste it here. Keep this file out of git.
ANTHROPIC_API_KEY=

# Only if the API answers "this API key is not scoped to a workspace": the ID of the workspace
# to bill (starts with wrkspc_; shown in the Console under Settings > Workspaces).
ANTHROPIC_WORKSPACE_ID=

# Which Claude model answers, and how hard it thinks (low | medium | high).
# Cheaper options: claude-sonnet-5-5, claude-haiku-5-5
SAKUBUN_MODEL=claude-opus-5-5
SAKUBUN_EFFORT=medium

# Where the server listens. 127.0.0.1 = this computer only.
# Use 0.0.0.0 to reach it from other devices on your network or tailnet (see the README first).
SAKUBUN_HOST=127.0.0.1
SAKUBUN_PORT=8000
